PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexlify
DB_USER=postgres
DB_PASS=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=30d

# Firebase Admin SDK (FCM push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Groq LLM API
GROQ_API_KEY=gsk_CHANGE_ME_your_groq_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Google Speech-to-Text
GOOGLE_SPEECH_API_KEY=AIzaSy_your_google_speech_api_key

# Internal AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=CHANGE_ME_internal_shared_secret_key
