<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required to get list of all installed apps in Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Required to launch the blocking activity -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Required for Detox Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application>
        <!-- 5.1.2 AccessibilityService detects when a blocked app comes to foreground -->
        <service
            android:name=".AppBlockingService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 5.1.3 Full-screen overlay Activity covering the app -->
        <activity
            android:name=".OverlayActivity"
            android:theme="@android:style/Theme.Light.NoTitleBar"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- 5.2.2 Persistent Foreground Service for Detox -->
        <service
            android:name=".DetoxService"
            android:exported="false" />
    </application>
</manifest>
